{
  "name": "@agichat/transport-ws",
  "version": "0.1.0",
  "description": "Adaptador WebSocket que implementa el puerto ChatTransport de @agichat/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@agichat/core": "workspace:*"
  },
  "devDependencies": {
    "@agichat/mock-server": "workspace:*",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  }
}
