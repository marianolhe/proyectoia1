# Copie este archivo a .env en la raiz del repositorio.

# Puerto en el que escucha packages/mock-server (pnpm mock).
AGICHAT_MOCK_PORT=8787

# URL del WebSocket que usa la demo (pnpm dev). Vite solo expone al navegador
# las variables con prefijo VITE_. Si se deja vacia, la demo usa el agente
# simulado dentro del navegador, sin servidor.
VITE_AGICHAT_WS_URL=ws://localhost:8787
