# URL del transporte WebSocket que consume el widget.
# Fase 1 apunta al mock local; en Fase 2 se cambia por el agente real
# sin tocar una sola linea de la interfaz.
AGICHAT_WS_URL=ws://localhost:8787

# Puerto en el que escucha packages/mock-server.
AGICHAT_MOCK_PORT=8787

# La app demo usa Vite: las variables expuestas al navegador llevan prefijo VITE_.
VITE_AGICHAT_WS_URL=ws://localhost:8787
