# Copie este archivo a .env en la raiz del repositorio y complete los valores.
# .env esta en .gitignore: nunca suba claves al repositorio.

# --- Modelo de lenguaje (agent-server) ---------------------------------------
# Opcion A (por defecto): Gemini gratis, sin tarjeta, con la API "chat
# completions". Clave en https://aistudio.google.com/apikey. Sirve igual para
# Groq u Ollama cambiando la URL y el modelo.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Opcion B: Claude (de pago). Comente las lineas de arriba y descomente estas.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- The Movie Database (mcp-tmdb) -------------------------------------------
# Cree la clave como estudiantes del curso CC3116 de la UVG, uso no comercial.
# Basta con una de las dos; se prefiere el token de lectura.
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=
# TMDB_LANGUAGE=es-MX

# --- Google Books (mcp-books) -------------------------------------------------
# Necesaria en la practica: sin clave se usa un cupo anonimo compartido que
# suele estar agotado (error 429). Se crea gratis y sin tarjeta.
GOOGLE_BOOKS_API_KEY=

# --- Puertos -----------------------------------------------------------------
# Cada servicio tiene su variable para que no choquen al correr en local.
# PORT es el WebSocket del agente que usa el widget.
PORT=8787
MCP_TMDB_PORT=8801
MCP_BOOKS_PORT=8802

# --- Servidor del agente ------------------------------------------------------
# MCP Servers que consume el agente (nombre=url, separados por coma). Con
# docker compose se fija solo; este valor es para correr sin contenedores.
MCP_SERVERS=tmdb=http://localhost:8801/mcp,books=http://localhost:8802/mcp
# Origenes que pueden abrir el WebSocket, separados por coma. Vacio = todos.
ALLOWED_ORIGINS=
# Mensajes por minuto por conexion.
RATE_LIMIT_PER_MINUTE=20

# --- Proyecto 1 ---------------------------------------------------------------
# Puerto del agente simulado (pnpm mock).
AGICHAT_MOCK_PORT=8787
# URL del WebSocket que usa la demo (pnpm dev). Si se deja vacia, la demo usa
# el agente simulado dentro del navegador, sin servidor.
VITE_AGICHAT_WS_URL=ws://localhost:8787
